{
  // Bindings apply while a PDF viewer iframe (class `.pdf-view`) holds focus.
  // Keystrokes captured inside the PDF.js document are redispatched onto this
  // element, so these fire whether focus is on the frame or its contents.
  ".pdf-view": {
    "f5": "pdf-view:refresh",
    "ctrl-f5": "pdf-view:toggle-refreshing",
    "f12": "pdf-view:compile",
    "up": "pdf-view:scroll-up",
    "down": "pdf-view:scroll-down",
    "left": "pdf-view:scroll-left",
    "right": "pdf-view:scroll-right",
    "pageup": "pdf-view:page-up",
    "pagedown": "pdf-view:page-down",
    "space": "pdf-view:page-down",
    "shift-space": "pdf-view:page-up",
    "home": "pdf-view:first-page",
    "end": "pdf-view:last-page",
    "enter": "pdf-view:next-page",
    "shift-enter": "pdf-view:previous-page",
    "n": "pdf-view:next-page",
    "j": "pdf-view:next-page",
    "p": "pdf-view:previous-page",
    "k": "pdf-view:previous-page",
    "cmdorctrl-=": "pdf-view:zoom-in",
    "cmdorctrl-+": "pdf-view:zoom-in",
    "cmdorctrl--": "pdf-view:zoom-out",
    "cmdorctrl-0": "pdf-view:zoom-reset",
    "r": "pdf-view:rotate-clockwise",
    "shift-r": "pdf-view:rotate-counterclockwise",
    "s": "pdf-view:select-tool",
    "h": "pdf-view:hand-tool",
    "cmdorctrl-f": "pdf-view:find",
    "cmdorctrl-g": "pdf-view:find-next",
    "cmdorctrl-shift-g": "pdf-view:find-previous",
    "f4": "pdf-view:toggle-sidebar",
    "cmdorctrl-alt-p": "pdf-view:presentation-mode",
    "cmdorctrl-s": "pdf-view:download",
    "cmdorctrl-c": "pdf-view:copy",
  },
}
