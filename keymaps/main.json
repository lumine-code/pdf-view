{
  ".pdf-view": {
    "up": "pdf-view:scroll-up",
    "down": "pdf-view:scroll-down",
    "left": "pdf-view:scroll-left",
    "right": "pdf-view:scroll-right",
    "r": "pdf-view:refresh",
    "f5": "pdf-view:refresh",
    "pageup": "pdf-view:previous-page",
    "pagedown": "pdf-view:next-page",
    "space": "pdf-view:page-down",
    "shift-space": "pdf-view:page-up",
    "home": "pdf-view:first-page",
    "end": "pdf-view:last-page",
    "=": "pdf-view:zoom-in",
    "+": "pdf-view:zoom-in",
    "-": "pdf-view:zoom-out",
    "_": "pdf-view:zoom-out",
    "0": "pdf-view:zoom-100",
    "cmdorctrl-=": "pdf-view:zoom-next-level",
    "cmdorctrl-+": "pdf-view:zoom-next-level",
    "cmdorctrl--": "pdf-view:zoom-previous-level",
    "cmdorctrl-_": "pdf-view:zoom-previous-level",
    "cmdorctrl-0": "pdf-view:zoom-100",
    "a": "pdf-view:automatic-zoom",
    "f": "pdf-view:fit-to-view",
    "w": "pdf-view:fit-width",
    "]": "pdf-view:rotate-clockwise",
    "[": "pdf-view:rotate-counterclockwise",
    "s": "pdf-view:select-tool",
    "h": "pdf-view:hand-tool",
    "cmdorctrl-c": "pdf-view:copy"
  },
  ".pdf-view .native-key-bindings": {
    "up": "native!",
    "down": "native!",
    "left": "native!",
    "right": "native!",
    "r": "native!",
    "pageup": "native!",
    "pagedown": "native!",
    "space": "native!",
    "shift-space": "native!",
    "home": "native!",
    "end": "native!",
    "=": "native!",
    "+": "native!",
    "-": "native!",
    "_": "native!",
    "cmdorctrl-=": "native!",
    "cmdorctrl-+": "native!",
    "cmdorctrl--": "native!",
    "cmdorctrl-_": "native!",
    "cmdorctrl-0": "native!",
    "0": "native!",
    "a": "native!",
    "f": "native!",
    "w": "native!",
    "]": "native!",
    "[": "native!",
    "s": "native!",
    "h": "native!",
    "cmdorctrl-c": "native!"
  }
}
