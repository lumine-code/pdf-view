{
  "name": "pdf-view",
  "author": "lumine-code",
  "description": "View PDF files directly in Lumine",
  "repository": "https://github.com/lumine-code/pdf-view",
  "bugs": {
    "url": "https://github.com/lumine-code/pdf-view/issues"
  },
  "homepage": "https://github.com/lumine-code/pdf-view#readme",
  "pdfjsVersion": "6.1.200",
  "keywords": [
    "pdf",
    "viewer",
    "synctex",
    "latex",
    "typst",
    "sofistik"
  ],
  "version": "3.0.0",
  "license": "MIT",
  "engines": {
    "atom": ">=1.100.0 <2.0.0"
  },
  "main": "./lib/main",
  "scripts": {
    "test": "cd ../lumine && npm run test:only -- ../pdf-view/spec",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "update": "node scripts/update.js"
  },
  "deserializers": {
    "pdf-view": "deserialize"
  },
  "providedServices": {
    "pdf-view": {
      "versions": {
        "1.0.0": "provideViewer",
        "1.1.0": "provideViewer"
      }
    },
    "navigation-adapter": {
      "versions": {
        "1.0.0": "provideNavigationAdapter"
      }
    }
  },
  "consumedServices": {
    "latex-tools": {
      "versions": {
        "1.0.0": "consumeLatexTools"
      }
    },
    "typst-tools": {
      "versions": {
        "1.0.0": "consumeTypstTools"
      }
    },
    "simplemap": {
      "versions": {
        "1.0.0": "consumeSimpleMap"
      }
    }
  },
  "configSchema": {
    "autoRefresh": {
      "order": 1,
      "title": "Auto-reload on update",
      "description": "Automatically reload when the file is updated. The window can be refreshed manually by press `F5` in pdf-view.",
      "type": "boolean",
      "default": true
    },
    "autoTime": {
      "order": 2,
      "title": "Auto-refresh delay",
      "description": "The time in ms before reloading the pdf-view after the last detected change.",
      "type": "integer",
      "default": 1000
    },
    "closeDeleted": {
      "order": 3,
      "title": "Close panel if file deleted",
      "description": "Set to true to automatically close the pdf-view when the disk file is deleted.",
      "type": "boolean",
      "default": true
    },
    "defaultZoom": {
      "order": 4,
      "title": "Default zoom",
      "description": "The default zoom level when opening a PDF.",
      "type": "string",
      "default": "auto",
      "enum": [
        "auto",
        "page-fit",
        "page-width",
        "page-actual",
        "50",
        "75",
        "100",
        "125",
        "150",
        "200"
      ]
    },
    "defaultSidebar": {
      "order": 5,
      "title": "Default sidebar",
      "description": "The default sidebar view when opening a PDF.",
      "type": "string",
      "default": "none",
      "enum": [
        "none",
        "thumbs",
        "outline",
        "attachments"
      ]
    },
    "snoFilter": {
      "order": 6,
      "title": "Filter section numbers",
      "description": "Remove leading section numbers from PDF outline entries in navigation-panel.",
      "type": "boolean",
      "default": false
    },
    "scrollmap": {
      "order": 7,
      "title": "Scrollmap",
      "description": "Show PDF outline markers on the scrollbar when scrollmap is installed.",
      "type": "object",
      "properties": {
        "enabled": {
          "order": 1,
          "type": "boolean",
          "title": "Enabled",
          "default": true
        },
        "maxDepth": {
          "order": 2,
          "type": "integer",
          "title": "Max Depth",
          "description": "Maximum outline depth to show. Zero means no limit.",
          "minimum": 0,
          "default": 0
        },
        "threshold": {
          "order": 3,
          "type": "integer",
          "title": "Threshold",
          "description": "Hide markers if count exceeds this value. Zero means no limit.",
          "minimum": 0,
          "default": 0
        }
      }
    },
    "debug": {
      "order": 8,
      "title": "Debug",
      "description": "Show some errors in console.",
      "type": "boolean",
      "default": false
    }
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "prettier": "^3.9.5"
  }
}
