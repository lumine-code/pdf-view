{
  "name": "pdf-view",
  "author": "lumine-code",
  "description": "View PDF files directly in the editor.",
  "repository": "https://github.com/lumine-code/pdf-view",
  "bugs": {
    "url": "https://github.com/lumine-code/pdf-view/issues"
  },
  "homepage": "https://github.com/lumine-code/pdf-view#readme",
  "version": "1.0.0",
  "keywords": [
    "viewer",
    "synctex",
    "pdf.js",
    "latex",
    "typst",
    "document",
    "sofistik"
  ],
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "main": "./lib/main",
  "specPackages": [
    "search-panel",
    "navigation-panel",
    "language-regex",
    "invert-colors",
    "scrollmap",
    "marker",
    "breadcrumbs",
    "launcher",
    "open-external",
    "sofistik-tools"
  ],
  "files": [
    "docs",
    "keymaps",
    "lib",
    "menus",
    "scripts",
    "spec",
    "styles",
    "LICENSE",
    "THIRD_PARTY_NOTICES"
  ],
  "scripts": {
    "test": "lumine --test spec",
    "test:unit": "node --test spec/unit/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "deserializers": {
    "pdf-view": "deserialize"
  },
  "providedServices": {
    "pdf-view": {
      "versions": {
        "2.0.0": "providePdfView"
      }
    },
    "navigation.adapter": {
      "versions": {
        "1.0.0": "provideNavigationAdapter"
      }
    },
    "search.adapter": {
      "versions": {
        "2.0.0": "provideSearchAdapter"
      }
    },
    "invert-colors.provider": {
      "versions": {
        "1.0.0": "provideInversionProvider"
      }
    },
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "latex-tools": {
      "versions": {
        "^1.0.0": "consumeLatexTools"
      }
    },
    "typst-tools": {
      "versions": {
        "^1.0.0": "consumeTypstTools"
      }
    },
    "scrollmap.widget": {
      "versions": {
        "^1.0.0": "consumeScrollmapWidget"
      }
    }
  },
  "configSchema": {
    "autoRefresh": {
      "title": "Auto Refresh",
      "description": "Reload PDFs when their files change on disk.",
      "type": "boolean",
      "default": true
    },
    "defaultZoom": {
      "title": "Default Zoom",
      "description": "Initial zoom for newly opened documents.",
      "type": "string",
      "enum": [
        "auto",
        "page-fit",
        "page-width",
        "page-actual"
      ],
      "default": "auto"
    },
    "maxCanvasPixels": {
      "title": "Maximum Canvas Pixels",
      "description": "Limit each rendered page canvas to bound memory use at high zoom.",
      "type": "integer",
      "minimum": 1048576,
      "default": 8388608
    },
    "scrollmap": {
      "title": "Scrollmap",
      "description": "PDF heading markers on the scrollbar overview.",
      "type": "object",
      "properties": {
        "maxDepth": {
          "title": "Maximum Heading Level",
          "description": "Show outline headings up to this level. Zero shows all levels.",
          "type": "integer",
          "minimum": 0,
          "default": 1
        }
      }
    }
  },
  "dependencies": {
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
